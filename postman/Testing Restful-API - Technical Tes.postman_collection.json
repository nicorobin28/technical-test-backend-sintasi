    {
      "name": "Login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cookieJar = await pm.cookies.jar();\r\n\r\ncookieJar.get(\"http://localhost:8000\", \"XSRF-TOKEN\", (error, cookie) => {\r\n    if (error) {\r\n        console.error(error);\r\n        return;\r\n    }\r\n\r\n    if (!cookie) {\r\n        console.error(\"XSRF-TOKEN tidak ditemukan\");\r\n        return;\r\n    }\r\n\r\n    console.log(\"XSRF-TOKEN:\", cookie.value);\r\n\r\n    pm.request.headers.upsert({\r\n        key: \"X-XSRF-TOKEN\",\r\n        value: decodeURIComponent(cookie.value)\r\n    });\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "http://localhost:9000"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"\",\r\n  \"password\": \"\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api_url}}/login",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "login"
          ]
        }
      },
